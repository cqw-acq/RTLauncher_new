{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlauncher.example/schemas/theme-manifest-1.0.json",
  "title": "RTLauncher Theme manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "engines",
    "entry",
    "supports"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": {
      "type": "string",
      "pattern": "^(?!builtin\\.)[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "$ref": "#/$defs/author" },
    "license": { "type": "string" },
    "homepage": { "type": "string" },
    "icon": { "$ref": "#/$defs/packagePath" },
    "previews": {
      "type": "array",
      "items": { "$ref": "#/$defs/packagePath" },
      "uniqueItems": true
    },
    "engines": { "$ref": "#/$defs/engines" },
    "entry": { "$ref": "#/$defs/entry" },
    "supports": { "$ref": "#/$defs/supports" },
    "contributes": { "$ref": "#/$defs/contributes" },
    "disclosures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unsafeCommands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rtlauncher", "themeApi"],
      "properties": {
        "rtlauncher": { "type": "string", "minLength": 1 },
        "themeApi": { "type": "string", "minLength": 1 },
        "themeUi": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": { "$ref": "#/$defs/packagePath" },
        "style": { "$ref": "#/$defs/packagePath" }
      }
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorSchemes"],
      "properties": {
        "colorSchemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "locales": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "userOverrides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["accentColor", "fontSize", "backgroundImage"] }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeContribution" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slotContribution" }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": { "$ref": "#/$defs/packagePath" },
            "defaults": { "$ref": "#/$defs/packagePath" }
          }
        }
      }
    },
    "routeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "target": { "$ref": "#/$defs/coreRoute" },
        "path": { "type": "string", "pattern": "^/" },
        "mode": { "enum": ["replace", "wrap"] }
      },
      "oneOf": [
        { "required": ["target"], "not": { "required": ["path"] } },
        { "required": ["path"], "not": { "required": ["target"] } }
      ]
    },
    "slotContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "target": { "$ref": "#/$defs/coreSlot" },
        "mode": { "enum": ["replace", "before", "after", "wrap"] },
        "order": { "type": "integer" }
      }
    },
    "coreRoute": {
      "enum": [
        "core.home",
        "core.launch",
        "core.download",
        "core.download.detail",
        "core.multiplayer",
        "core.tools",
        "core.settings",
        "core.game-settings",
        "core.instance.mods",
        "core.instance.worlds",
        "core.instance.resources",
        "core.instance.shaders",
        "core.instance.screenshots",
        "core.instance.schematics"
      ]
    },
    "coreSlot": {
      "enum": [
        "app.titlebar.leading",
        "app.titlebar.center",
        "app.titlebar.actions",
        "app.sidebar",
        "app.sidebar.header",
        "app.sidebar.navigation",
        "app.sidebar.footer",
        "app.content.before",
        "app.content.after",
        "page.header",
        "page.header.actions",
        "page.footer",
        "launch.primary-action"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/packagePath" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256-[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  }
}
